{
  "name": "my-theme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && pnpm run build:blocks",
    "build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=theme-blocks/bundled",
    "lint:scss": "stylelint \"src/frontend/scss/**/*.scss\" \"src/blocks/**/*.{css,scss}\""
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "devDependencies": {
    "@wordpress/browserslist-config": "^6.40.0",
    "@wordpress/scripts": "^31.4.0",
    "sass": "^1.96.0",
    "stylelint": "^17.2.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^7.2.7"
  }
}
